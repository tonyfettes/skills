// Run MoonBit native tests with AddressSanitizer.
//
// Patches `link.native` in each specified moon.pkg with ASan flags (only the
// `link` value is rewritten, so every other declaration is kept verbatim),
// builds with the system allocator instead of the bundled mimalloc
// (`MOONBIT_ALLOCATOR=system`, so ASan sees every allocation), runs
// `moon test`, and restores everything afterward. Legacy moon.pkg.json is not
// supported: current moon rejects it, so run `moon fmt` to migrate first.
//
// Usage:
//   moon run --target native scripts/run-asan.mbtx -- \
//     --repo-root <project-root> \
//     --pkg moon.pkg \
//     --pkg main/moon.pkg

///|
import {
  "moonbitlang/async",
  "moonbitlang/async/process",
  "moonbitlang/async/fs",
  "moonbitlang/x/path",
  "moonbitlang/x/sys",
  "moonbitlang/moon_config",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

///|
let asan_compile_flags : String = "-g -fsanitize=address -fno-omit-frame-pointer"

// ---------------------------------------------------------------------------
// AST → JSON conversion
// ---------------------------------------------------------------------------

///|
/// Convert moon_config Ast to plain Json (strip location info).
fn ast_to_json(ast : @moon_config.Ast) -> Json {
  match ast {
    Null(..) => Json::null()
    Bool(value, ..) => Json::boolean(value)
    Str(str, ..) => Json::string(str)
    Float(float, ..) =>
      // Integer literals in moon.pkg (e.g. "123"). Try parsing as JSON number.
      @json.parse(float) catch {
        _ => Json::string(float)
      }
    Arr(content, ..) => Json::array(content.to_array().map(ast_to_json))
    Obj(fields, ..) => {
      let obj : Map[String, Json] = Map([])
      for field in fields {
        let (k, v) = field
        obj[k] = ast_to_json(v)
      }
      Json::object(obj)
    }
  }
}

// ---------------------------------------------------------------------------
// Platform detection
// ---------------------------------------------------------------------------

///|
struct AsanConfig {
  cc : String
  cc_flags : String
  stub_cc_flags : String? // Some → override entirely (Windows); None → append
  detect_leaks : String
}

///|
/// Find Homebrew LLVM clang (supports both ASan and LSan).
async fn find_brew_clang() -> String? {
  let brew = match @process.collect_stdout("which", ["brew"]) {
    (0, out) => out.text().trim_end().to_owned()
    _ =>
      if @fs.exists("/opt/homebrew/bin/brew") {
        "/opt/homebrew/bin/brew"
      } else {
        return None
      }
  }
  let versions = ["llvm", "llvm@18", "llvm@19", "llvm@15", "llvm@13"]
  for ver in versions {
    let (code, out) = @process.collect_stdout(brew[:], ["--prefix", ver])
    if code == 0 {
      let prefix = out.text().trim_end().to_owned()
      let clang = "\{prefix}/bin/clang"
      if @fs.exists(clang[:]) {
        return Some(clang)
      }
    }
  }
  None
}

///|
/// Check whether a compiler supports -fsanitize=address (compile + link).
async fn check_system_asan(cc : String) -> Bool {
  let dir = @fs.tmpdir(prefix="asan-check-")
  let src = @path.Path(dir).join(@path.Path("t.c")).to_string()
  let out = @path.Path(dir).join(@path.Path("t.out")).to_string()
  @fs.write_file(src[:], "int main(){return 0;}", create_mode=CreateOrTruncate)
  let code = @process.run(cc[:], ["-fsanitize=address", src, "-o", out])
  @fs.rmdir(dir[:], recursive=true)
  code == 0
}

///|
/// Determine ASan compiler and flags for the current platform.
async fn get_asan_config() -> AsanConfig {
  if @async.platform is MacOS {
    // Prefer Homebrew LLVM (supports LSan)
    match find_brew_clang() {
      Some(clang) =>
        return {
          cc: clang,
          cc_flags: asan_compile_flags,
          stub_cc_flags: None,
          detect_leaks: "1",
        }
      None => ()
    }
    // Fall back to system clang (Xcode 15+, ASan only, no LSan)
    let cc = match @process.collect_stdout("which", ["cc"]) {
      (0, out) => out.text().trim_end().to_owned()
      _ => "/usr/bin/cc"
    }
    if check_system_asan(cc) {
      return {
        cc,
        cc_flags: asan_compile_flags,
        stub_cc_flags: None,
        detect_leaks: "0",
      }
    }
    println(
      "Error: No ASan-capable compiler found. Install Homebrew LLVM: brew install llvm",
    )
    @sys.exit(1)
    panic()
  } else if @async.platform is Linux {
    let cc = match @process.collect_stdout("which", ["cc"]) {
      (0, out) => out.text().trim_end().to_owned()
      _ => "gcc"
    }
    {
      cc,
      cc_flags: asan_compile_flags,
      stub_cc_flags: None,
      detect_leaks: "1",
    }
  } else {
    // Windows
    {
      cc: "cl",
      cc_flags: "/Z7 /fsanitize=address",
      stub_cc_flags: Some("/Z7 /fsanitize=address"),
      detect_leaks: "0",
    }
  }
}

// ---------------------------------------------------------------------------
// Package file handling
// ---------------------------------------------------------------------------

///|
/// Resolve a --pkg argument (a moon.pkg path, or the package directory) to
/// an absolute moon.pkg path.
async fn resolve_pkg_path(repo_root : String, pkg_arg : String) -> String {
  let requested = if @path.Path(pkg_arg).is_absolute() {
    pkg_arg
  } else {
    @path.Path(repo_root).join(@path.Path(pkg_arg)).to_string()
  }
  let candidate = if @path.Path(requested).basename() == "moon.pkg" {
    requested
  } else {
    @path.Path(requested).join(@path.Path("moon.pkg")).to_string()
  }
  if @fs.exists(candidate[:]) {
    return @fs.realpath(candidate[:])
  }
  println("Error: moon.pkg not found for --pkg \{pkg_arg} (tried \{candidate})")
  let legacy = @path.Path(candidate)
    .dirname()
    .join(@path.Path("moon.pkg.json"))
    .to_string()
  if @fs.exists(legacy[:]) {
    println("  Found legacy moon.pkg.json; run `moon fmt` to migrate it first.")
  }
  @sys.exit(1)
  panic()
}

///|
/// Check if a package is an entry package (executable or has tests).
/// Only entry packages get cc-flags and cc-link-flags patched.
async fn is_entry_package(fields : Map[String, Json], pkg_dir : String) -> Bool {
  if fields.get("pkgtype") is Some(Object(pkgtype)) &&
    pkgtype.get("kind") is Some(String("executable")) {
    return true
  }
  // Deprecated spellings of `pkgtype(kind: "executable")`
  if fields.get("is-main") is Some(True) || fields.get("is_main") is Some(True) {
    return true
  }
  let entries = @fs.readdir(pkg_dir[:])
  for entry in entries {
    // Check for *_test.mbt files
    if entry.has_suffix("_test.mbt") {
      return true
    }
    // Check for inline test blocks in .mbt files (e.g. python.mbt)
    if entry.has_suffix(".mbt") {
      let fpath = @path.Path(pkg_dir).join(@path.Path(entry)).to_string()
      let content = @fs.read_file(fpath[:]).text()
      if content.contains("\ntest ") {
        return true
      }
    }
  }
  false
}

///|
/// Append `flags` to the string field `key` of `native`, keeping existing
/// flags (e.g. -I, -D paths needed for compilation).
fn append_flags(
  native : Map[String, Json],
  key : String,
  flags : String,
) -> Unit {
  native[key] = match native.get(key) {
    Some(String(existing)) if existing != "" =>
      Json::string("\{existing} \{flags}")
    _ => Json::string(flags)
  }
}

///|
/// Patch a `link` object with ASan flags.
/// Always patches stub-cc-flags. Only patches cc-flags on entry packages.
fn patch_link(
  link : Map[String, Json],
  asan : AsanConfig,
  is_entry : Bool,
) -> Map[String, Json] {
  let native : Map[String, Json] = match link.get("native") {
    Some(Object(native)) => native
    _ => {
      let native : Map[String, Json] = Map([])
      link["native"] = Json::object(native)
      native
    }
  }
  // cc-flags: entry packages only (instruments MoonBit-generated C).
  // cc-link-flags: ensure the ASan runtime is linked (required when stubs
  // are compiled with -fsanitize=address but the linker step needs it too).
  if is_entry {
    append_flags(native, "cc-flags", asan.cc_flags)
    append_flags(native, "cc-link-flags", "-fsanitize=address")
  }
  // stub-cc-flags: all packages (instruments C stub files)
  match asan.stub_cc_flags {
    // Windows: override entirely
    Some(flags) => native["stub-cc-flags"] = Json::string(flags)
    None => append_flags(native, "stub-cc-flags", asan_compile_flags)
  }
  link
}

///|
/// Return the patched text of a moon.pkg and whether it is an entry package.
/// Only the `link` value is rewritten (or an `options(link: ...)` entry
/// added); every other declaration keeps its original text.
async fn patch_pkg(
  path : String,
  content : String,
  asan : AsanConfig,
) -> (String, Bool) {
  let (ast, reports) = @moon_config.parse_moon_pkg(content, name=path)
  for report in reports {
    println("Warning: \{report}")
  }
  guard ast is Obj(entries, ..) else {
    fail("\{path}: unexpected moon.pkg shape")
  }
  // `options(...)` entries are flattened to the top level by the parser.
  let fields : Map[String, Json] = Map([])
  let mut link_ast : @moon_config.Ast? = None
  for entry in entries {
    let (key, value) = entry
    fields[key] = ast_to_json(value)
    if key == "link" {
      link_ast = Some(value)
    }
  }
  let pkg_dir = @path.Path(path).dirname().to_string()
  let is_entry = is_entry_package(fields, pkg_dir)
  let link : Map[String, Json] = match fields.get("link") {
    None => Map([])
    Some(Object(link)) => link
    Some(_) =>
      fail(
        "\{path}: boolean `link` is deprecated; migrate to `pkgtype(kind: \"foreign_library\")` first",
      )
  }
  let patched = Json::object(patch_link(link, asan, is_entry)).stringify()
  let text = if link_ast is Some(value) {
    let loc = value.loc()
    "\{content[:loc.start.cnum]}\{patched}\{content[loc.end.cnum:]}"
  } else {
    let options_at = if content.has_prefix("options(") {
      Some(0)
    } else {
      content.find("\noptions(").map(i => i + 1)
    }
    match options_at {
      Some(at) => {
        let split = at + "options(".length()
        "\{content[:split]}\n  link: \{patched},\{content[split:]}"
      }
      None => {
        let sep = if content.has_suffix("\n") { "" } else { "\n" }
        "\{content}\{sep}\noptions(\n  link: \{patched},\n)\n"
      }
    }
  }
  (text, is_entry)
}

// ---------------------------------------------------------------------------
// Snapshot & restore
// ---------------------------------------------------------------------------

///|
struct Snapshot {
  path : String
  content : String
}

///|
/// Restore all snapshotted files.
async fn restore(snapshots : Array[Snapshot]) -> Unit {
  for s in snapshots {
    @fs.write_file(s.path[:], s.content, create_mode=CreateOrTruncate)
    println("Restored: \{s.path}")
  }
}

///|
/// Patch every package, run the tests, and restore everything on exit —
/// including when patching or the test run fails.
async fn run_patched(
  repo_root : String,
  snapshots : Array[Snapshot],
  asan : AsanConfig,
  system_allocator : Bool,
) -> Int32 {
  defer @async.protect_from_cancel(() => restore(snapshots))
  for snapshot in snapshots {
    let (text, is_entry) = patch_pkg(snapshot.path, snapshot.content, asan)
    @fs.write_file(snapshot.path[:], text, create_mode=CreateOrTruncate)
    let kind = if is_entry { "entry" } else { "library" }
    println("Patched (\{kind}): \{snapshot.path}")
  }

  // Build environment
  let extra_env : Map[String, String] = Map([])
  if @async.platform is MacOS {
    extra_env["MOON_CC"] = asan.cc
    extra_env["MOON_AR"] = "/usr/bin/ar"
  }
  if system_allocator {
    // The bundled mimalloc hides allocations from ASan.
    extra_env["MOONBIT_ALLOCATOR"] = "system"
  }
  extra_env["ASAN_OPTIONS"] = "detect_leaks=\{asan.detect_leaks}:fast_unwind_on_malloc=0"
  let lsan_supp = @path.Path(repo_root)
    .join(@path.Path(".lsan-suppressions"))
    .to_string()
  if @fs.exists(lsan_supp[:]) {
    extra_env["LSAN_OPTIONS"] = "suppressions=\{lsan_supp}"
  }

  // Run tests
  @process.run(
    "moon",
    ["test", "--target", "native", "-v"],
    cwd=repo_root[:],
    extra_env~,
  )
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

///|
async fn main {
  // ---- Parse arguments ----
  let cmd = @argparse.Command(
    "run-asan",
    about="Run MoonBit native tests with AddressSanitizer",
    options=[
      @argparse.OptionArg(
        "repo-root",
        long="repo-root",
        about="Project repository root",
        required=true,
      ),
      @argparse.OptionArg(
        "pkg",
        long="pkg",
        about="Path to a moon.pkg or its package directory (repeatable)",
        action=Append,
      ),
    ],
    flags=[
      @argparse.FlagArg(
        "no-disable-mimalloc",
        long="no-disable-mimalloc",
        about="Keep the bundled mimalloc allocator (not recommended)",
      ),
    ],
  )
  let matches = cmd.parse() catch {
    _ => {
      println("Error: failed to parse arguments")
      @sys.exit(1)
      panic()
    }
  }
  let repo_root = match matches.values.get("repo-root") {
    Some(vals) if vals.length() > 0 => @fs.realpath(vals[0][:])
    _ => {
      println("Error: --repo-root is required")
      @sys.exit(1)
      panic()
    }
  }
  let pkg_args = match matches.values.get("pkg") {
    Some(vals) if vals.length() > 0 => vals
    _ => {
      println(
        "Error: No --pkg arguments provided. Specify at least one moon.pkg.",
      )
      @sys.exit(1)
      panic()
    }
  }
  let no_disable_mimalloc = matches.flags
    .get("no-disable-mimalloc")
    .unwrap_or(false)

  // ---- Validate ----
  if !@fs.exists(repo_root[:]) {
    println("Error: --repo-root is not a directory: \{repo_root}")
    @sys.exit(1)
  }
  let mod_file = @path.Path(repo_root).join(@path.Path("moon.mod")).to_string()
  if !@fs.exists(mod_file[:]) {
    println(
      "Warning: no moon.mod found in \{repo_root}. Is --repo-root correct? (Legacy moon.mod.json must be migrated with `moon fmt`.)",
    )
  }

  // ---- Resolve package paths (deduplicate) ----
  let pkg_paths : Array[String] = []
  let seen : Set[String] = Set([])
  for arg in pkg_args {
    let path = resolve_pkg_path(repo_root, arg)
    if !seen.contains(path) {
      seen.add(path)
      pkg_paths.push(path)
    }
  }

  // ---- ASan config ----
  let asan = get_asan_config()
  let platform_name = if @async.platform is MacOS {
    "Darwin"
  } else if @async.platform is Linux {
    "Linux"
  } else {
    "Windows"
  }
  let leak_enabled = asan.detect_leaks == "1"
  let leak_status = if leak_enabled { "enabled" } else { "disabled" }
  println("Platform: \{platform_name}")
  println("ASan compiler: \{asan.cc}")
  println("ASan compile flags: \{asan.cc_flags}")
  println("Leak detection: \{leak_status}")

  // ---- Snapshot original files ----
  let snapshots = []
  for path in pkg_paths {
    snapshots.push(Snapshot::{ path, content: @fs.read_file(path[:]).text(), })
  }

  // ---- Patch, run, restore ----
  let exit_code = run_patched(repo_root, snapshots, asan, !no_disable_mimalloc) catch {
    e => {
      println("Error during patching/testing: \{e}")
      1
    }
  }
  @sys.exit(exit_code)
}
